{% comment %}
  Atelier Circle — stitch §7
  浅底 + 深色卡片；标题 Inaugural Acquisition Privilege；按钮 Request Entry
  （The Olfactory Gazette 在 footer，不在此处）
{% endcomment %}

<section class="qs-newsletter">
  <div class="page-width">
    <div class="qs-newsletter__card" style="background-color: {{ section.settings.bg_color }}">
      {% if section.settings.eyebrow != blank %}
        <p class="qs-newsletter__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% if section.settings.title != blank %}
        <h2 class="qs-newsletter__title">{{ section.settings.title }}</h2>
      {% endif %}
      {% if section.settings.text != blank %}
        <p class="qs-newsletter__text">{{ section.settings.text }}</p>
      {% endif %}

      {% form 'customer', class: 'qs-newsletter__form' %}
        <input type="hidden" name="contact[tags]" value="newsletter,atelier-circle">
        <label class="visually-hidden" for="QsNewsletterEmail-{{ section.id }}">Email</label>
        <input
          id="QsNewsletterEmail-{{ section.id }}"
          class="qs-newsletter__input"
          type="email"
          name="contact[email]"
          value="{{ form.email }}"
          placeholder="{{ section.settings.placeholder }}"
          required
          autocomplete="email"
        >
        <button type="submit" class="qs-newsletter__submit" name="commit">
          {{ section.settings.button_label }}
        </button>

        {% if form.errors %}
          <p class="qs-newsletter__message qs-newsletter__message--error" role="alert">
            {{ form.errors.translated_fields.email | capitalize }}
            {{ form.errors.messages.email }}
          </p>
        {% endif %}
        {% if form.posted_successfully? %}
          <p class="qs-newsletter__message qs-newsletter__message--success" role="status">
            {{ section.settings.success_message }}
          </p>
        {% endif %}
      {% endform %}

      {% if section.settings.fine_print != blank %}
        <p class="qs-newsletter__fine">{{ section.settings.fine_print }}</p>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
/* Atelier Circle — 浅底 + 深色左对齐卡片（对齐 desktop-home §7） */

.section-qs-newsletter .qs-newsletter,
.qs-newsletter {
  padding: 88px 0 !important;
  background: #f9f9f7 !important;
  font-family: 'Inter', system-ui, sans-serif;
}

.qs-newsletter__card {
  max-width: 56rem;
  margin: 0 auto;
  padding: 56px 48px;
  background: #2a2a2a;
  color: #fafaf8;
  position: relative;
  overflow: hidden;
  text-align: left;
}

.qs-newsletter__eyebrow {
  margin: 0 0 10px !important;
  font-size: 10px !important;
  font-weight: 600 !important;
  line-height: 14px !important;
  letter-spacing: 0.16em !important;
  text-transform: uppercase !important;
  color: #fddaac !important;
}

.qs-newsletter__title {
  margin: 0 0 16px !important;
  max-width: 28rem;
  font-size: 36px !important;
  font-weight: 300 !important;
  line-height: 44px !important;
  letter-spacing: -0.02em !important;
  color: #fafaf8 !important;
}

.qs-newsletter__text {
  margin: 0 0 32px !important;
  max-width: 34rem;
  font-size: 16px !important;
  line-height: 26px !important;
  font-weight: 300 !important;
  color: #e2e3e1 !important;
}

.qs-newsletter__form {
  display: flex !important;
  flex-wrap: nowrap;
  align-items: stretch;
  gap: 4px;
  max-width: 32rem;
  margin: 0;
}

.qs-newsletter__input {
  flex: 1 1 auto;
  min-width: 0;
  min-height: 52px;
  padding: 0 16px;
  border: 0;
  border-radius: 0;
  background: #fff !important;
  color: #2a2a2a !important;
  font-family: inherit;
  font-size: 14px !important;
  line-height: 22px !important;
}

.qs-newsletter__input::placeholder {
  color: #747878;
}

.qs-newsletter__input:focus {
  outline: none;
}

.qs-newsletter__submit {
  flex: 0 0 auto;
  min-height: 52px !important;
  padding: 0 28px !important;
  margin: 0 !important;
  border: 0 !important;
  border-radius: 0 !important;
  background: #fddaac !important;
  color: #785e39 !important;
  font-family: inherit !important;
  font-size: 12px !important;
  font-weight: 500 !important;
  letter-spacing: 0.14em !important;
  text-transform: uppercase !important;
  cursor: pointer;
  white-space: nowrap;
}

.qs-newsletter__submit:hover {
  background: #735a36 !important;
  color: #fff !important;
}

.qs-newsletter__message {
  flex: 1 1 100%;
  width: 100%;
  margin: 12px 0 0;
  font-size: 12px;
}

.qs-newsletter__message--success {
  color: #fddaac;
}

.qs-newsletter__message--error {
  color: #ffdad6;
}

.qs-newsletter__fine {
  margin: 20px 0 0 !important;
  font-size: 10px !important;
  font-weight: 600 !important;
  line-height: 14px !important;
  letter-spacing: 0.16em !important;
  text-transform: uppercase !important;
  color: #929191 !important;
}

@media (max-width: 749px) {
  .qs-newsletter__card {
    padding: 40px 24px;
  }

  .qs-newsletter__title {
    font-size: 30px !important;
    line-height: 38px !important;
  }

  .qs-newsletter__form {
    flex-direction: column;
  }

  .qs-newsletter__submit {
    width: 100%;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "邮件订阅",
  "tag": "section",
  "class": "section-qs-newsletter",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "眉题",
      "default": "The Atelier Circle"
    },
    {
      "type": "text",
      "id": "title",
      "label": "标题",
      "default": "Inaugural Acquisition Privilege"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "描述",
      "default": "Receive a 10% ceremonial courtesy on your first acquisition, accompanied by private access to limited Grasse seasonal distillations and private salon invitations."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "输入框占位",
      "default": "Your preferred email address"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "按钮文字",
      "default": "Request Entry"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "成功提示",
      "default": "Welcome to the Atelier Circle."
    },
    {
      "type": "text",
      "id": "fine_print",
      "label": "底部说明",
      "default": "Unsubscribing is honored without resistance. We do not transmit frequent correspondences."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "卡片背景色",
      "default": "#2A2A2A"
    }
  ],
  "presets": [{ "name": "邮件订阅" }]
}
{% endschema %}
