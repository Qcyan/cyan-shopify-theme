{% comment %}
  Brand pillars — 对齐 stitch 红框四列信任条
  Dual Origins / Carbon-Neutral / Monogramming / Circular Glass
{% endcomment %}

<section class="qs-usps" style="background-color: {{ section.settings.bg_color }}">
  <div class="page-width qs-usps__inner">
    <div class="qs-usps__grid">
      {% for block in section.blocks %}
        {% liquid
          assign icon = block.settings.icon_name | default: 'spa' | downcase | strip
        %}
        <article class="qs-usps__item" {{ block.shopify_attributes }}>
          <div class="qs-usps__icon" aria-hidden="true">
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 96
                | image_tag: loading: 'lazy', widths: '48, 72, 96', alt: ''
              }}
            {% else %}
              {% case icon %}
                {% when 'public', 'globe', 'earth' %}
                  <svg class="qs-usps__svg" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M3 12h18M12 3c2.5 2.8 3.8 6 3.8 9s-1.3 6.2-3.8 9c-2.5-2.8-3.8-6-3.8-9S9.5 5.8 12 3z" stroke="currentColor" stroke-width="1.5"/>
                  </svg>
                {% when 'edit_note', 'edit', 'pen' %}
                  <svg class="qs-usps__svg" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M4 20h4L18.5 9.5a2.1 2.1 0 0 0 0-3L16.5 4.5a2.1 2.1 0 0 0-3 0L4 14v6z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                    <path d="M13 6.5l3.5 3.5" stroke="currentColor" stroke-width="1.5"/>
                  </svg>
                {% when 'recycling', 'recycle' %}
                  <svg class="qs-usps__svg" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M7 19H4.5A1.5 1.5 0 0 1 3.2 16.7l2-3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    <path d="M9.5 8.5l2.5-4.3A1.5 1.5 0 0 1 14.6 4H17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    <path d="M17 19h2.5a1.5 1.5 0 0 0 1.3-2.3l-2-3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    <path d="M7 19l2-3.5M17 8.5l2 3.5M9.5 8.5H7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    <path d="M8.5 16.5l-1.5 2.5 2.5.2M15.5 7.5l1.5-2.5 1.2 2.2M18.5 14.5l2.2.8-1 2.2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                {% else %}
                  {% comment %} spa / leaf {% endcomment %}
                  <svg class="qs-usps__svg" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 21c0-6 3-10 9-12-1 7-4 11-9 12z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                    <path d="M12 21c0-6-3-10-9-12 1 7 4 11 9 12z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                    <path d="M12 21V10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>
              {% endcase %}
            {% endif %}
          </div>
          <div class="qs-usps__copy">
            {% if block.settings.title != blank %}
              <h3 class="qs-usps__title">{{ block.settings.title }}</h3>
            {% endif %}
            {% if block.settings.text != blank %}
              <p class="qs-usps__text">{{ block.settings.text }}</p>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
/* Brand pillars strip — 对齐设计稿红框区域，字号全部 px */

.section-qs-usps .qs-usps,
.qs-usps {
  padding: 36px 0 !important;
  background: #eeeeec !important;
  border: 0 !important;
  border-top: 1px solid #e2e3e1 !important;
  border-bottom: 1px solid #e2e3e1 !important;
  font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
}

.qs-usps__inner {
  width: 100%;
}

.section-qs-usps .qs-usps__grid,
.qs-usps__grid {
  display: grid !important;
  grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
  gap: 24px 28px !important;
  margin: 0 !important;
  padding: 0 !important;
  align-items: start;
}

.section-qs-usps .qs-usps__item,
.qs-usps__item {
  display: flex !important;
  flex-direction: row !important;
  align-items: flex-start !important;
  gap: 12px !important;
  margin: 0 !important;
  padding: 0 !important;
  max-width: none !important;
  text-align: left !important;
  background: transparent !important;
  border: 0 !important;
  box-shadow: none !important;
}

.qs-usps__icon {
  flex: 0 0 24px;
  width: 24px;
  height: 24px;
  margin-top: 1px;
  color: #735a36;
}

.qs-usps__icon img,
.qs-usps__svg {
  display: block;
  width: 24px;
  height: 24px;
}

.qs-usps__copy {
  min-width: 0;
  flex: 1;
  text-align: left !important;
}

.qs-usps__title {
  margin: 0 0 6px !important;
  padding: 0 !important;
  font-size: 12px !important;
  font-weight: 500 !important;
  line-height: 16px !important;
  letter-spacing: 0.14em !important;
  text-transform: uppercase !important;
  color: #2a2a2a !important;
  text-align: left !important;
}

.qs-usps__text {
  margin: 0 !important;
  padding: 0 !important;
  font-size: 12px !important;
  font-weight: 400 !important;
  line-height: 18px !important;
  letter-spacing: 0.01em;
  color: #444748 !important;
  text-align: left !important;
}

@media (max-width: 989px) {
  .section-qs-usps .qs-usps__grid,
  .qs-usps__grid {
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
  }
}

@media (max-width: 549px) {
  .qs-usps {
    padding: 28px 0 !important;
  }

  .section-qs-usps .qs-usps__grid,
  .qs-usps__grid {
    grid-template-columns: 1fr !important;
    gap: 20px !important;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "优势卖点",
  "tag": "section",
  "class": "section-qs-usps",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "背景色",
      "default": "#EEEEEC"
    }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "卖点",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "图标图片（优先）"
        },
        {
          "type": "select",
          "id": "icon_name",
          "label": "内置图标",
          "options": [
            { "value": "spa", "label": "叶片 (Dual Origins)" },
            { "value": "public", "label": "地球 (Shipping)" },
            { "value": "edit_note", "label": "刻字 (Monogram)" },
            { "value": "recycling", "label": "循环 (Refill)" }
          ],
          "default": "spa"
        },
        {
          "type": "text",
          "id": "title",
          "label": "标题",
          "default": "Dual Origins"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "描述",
          "default": "Harvested in Grasse, infused and structured in Kyoto."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "优势卖点",
      "blocks": [
        {
          "type": "usp",
          "settings": {
            "icon_name": "spa",
            "title": "Dual Origins",
            "text": "Harvested in Grasse, infused and structured in Kyoto."
          }
        },
        {
          "type": "usp",
          "settings": {
            "icon_name": "public",
            "title": "Carbon-Neutral Journey",
            "text": "Complimentary climate-neutral express shipping globally."
          }
        },
        {
          "type": "usp",
          "settings": {
            "icon_name": "edit_note",
            "title": "Bespoke Monogramming",
            "text": "Complimentary hand-chiseled initials on bottle caps."
          }
        },
        {
          "type": "usp",
          "settings": {
            "icon_name": "recycling",
            "title": "Circular Glass & Refill",
            "text": "Return empty flacons for refill credits at all salons."
          }
        }
      ]
    }
  ]
}
{% endschema %}
