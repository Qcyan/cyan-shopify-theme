  text-decoration: none !important;
}

.qs-product__add:hover {
  background: #2a2a2a !important;
}

.qs-product__ship-note {
  margin: 0;
  font-size: 12px;
  line-height: 18px;
  color: var(--qs-outline);
  text-align: center;
}

/* Accordions */
.qs-product__accords {
  border-top: 1px solid var(--qs-surface-3);
}

.qs-product__accord {
  border-bottom: 1px solid var(--qs-surface-3);
}

.qs-product__accord summary {
  list-style: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 16px 0;
  cursor: pointer;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--qs-ink);
}

.qs-product__accord summary::-webkit-details-marker {
  display: none;
}

.qs-product__accord-icon {
  font-size: 16px;
  line-height: 1;
  color: var(--qs-outline);
}

.qs-product__accord[open] .qs-product__accord-icon {
  transform: rotate(180deg);
}

.qs-product__accord-body {
  padding: 0 0 16px;
  font-size: 13px;
  line-height: 20px;
  color: var(--qs-muted);
}

.qs-product__accord-body p {
  margin: 0 0 8px;
}

.qs-product__accord-body p:last-child {
  margin-bottom: 0;
}

/* Related — 通栏灰底，与上方主内容拉开间距（stitch bg-surface-container-low） */
.qs-product__related {
  margin-top: 64px;
  padding: 72px 0 64px;
  background: #f4f4f2;
  width: 100%;
}

.qs-product__related-head {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24px 40px;
  margin-bottom: 40px;
}

.qs-product__related-lead {
  min-width: 0;
}

.qs-product__related-eyebrow {
  margin: 0 0 8px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--qs-gold);
}

.qs-product__related-title {
  margin: 0;
  font-size: 36px;
  font-weight: 300;
  line-height: 44px;
  letter-spacing: -0.02em;
  color: var(--qs-ink);
}

.qs-product__related-desc {
  margin: 0;
  max-width: 360px;
  font-size: 13px;
  line-height: 20px;
  color: var(--qs-muted);
}

.qs-product__related-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 28px;
}

.qs-product__related-grid .qs-product-card--collection {
  background: #ffffff;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
}

.qs-product__related-grid .qs-product-card--collection .qs-product-card__info {
  background: #ffffff;
}

/* Patron Notes — stitch Verified Patron Perspectives
   与上方 Ritual 灰底带之间留白间隔；用 margin 避开 Dawn .page-width { padding:0 } */
.qs-product .qs-product__reviews.page-width {
  margin-top: 56px;
  padding-top: 8px;
  padding-bottom: 80px;
  background: transparent;
}

.qs-product__reviews-summary {
  display: grid;
  grid-template-columns: 1fr 1.6fr auto;
  gap: 32px;
  align-items: center;
  padding: 36px 32px;
  margin-bottom: 28px;
  background: #f4f4f2;
}

.qs-product__reviews-score {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8px;
}

.qs-product__reviews-score-num {
  font-size: 48px;
  font-weight: 300;
  line-height: 1;
  letter-spacing: -0.02em;
  color: var(--qs-ink);
}

.qs-product__reviews-stars {
  color: var(--qs-gold);
  letter-spacing: 2px;
  font-size: 16px;
  line-height: 1;
}

.qs-product__reviews-stars--sm {
  font-size: 12px;
  margin-bottom: 10px;
}

.qs-product__reviews-score-meta {
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--qs-outline);
}

.qs-product__reviews-metrics {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.qs-product__metric-row {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 6px;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--qs-ink);
}

.qs-product__metric-row span:last-child {
  color: var(--qs-muted);
  flex-shrink: 0;
}

.qs-product__metric-track {
  height: 6px;
  background: #e2e3e1;
  overflow: hidden;
}

.qs-product__metric-fill {
  display: block;
  height: 100%;
  background: #151616;
}

.qs-product__reviews-cta {
  display: flex;
  justify-content: flex-end;
}

.qs-product__reviews-submit {
  padding: 12px 20px;
  border: 0;
  background: #ffffff;
  font-family: inherit;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--qs-ink);
  cursor: pointer;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
}

.qs-product__reviews-filters {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 28px;
}

.qs-product__filter-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.qs-product__chip {
  padding: 8px 12px;
  border: 0;
  background: #f4f4f2;
  font-family: inherit;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--qs-ink);
  cursor: default;
}

.qs-product__chip.is-active {
  background: #151616;
  color: #ffffff;
}

.qs-product__reviews-sort {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--qs-outline);
}

.qs-product__reviews-sort-value {
  color: var(--qs-ink);
}

.qs-product__reviews-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
}

.qs-product__review-card {
  display: flex;
  flex-direction: column;
  padding: 28px;
  background: #f4f4f2;
}

.qs-product__review-head {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 8px 16px;
  margin-bottom: 12px;
}

.qs-product__review-author {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
}

.qs-product__review-name {
  font-size: 14px;
  font-weight: 500;
  color: var(--qs-ink);
}

.qs-product__review-badge {
  padding: 3px 6px;
  background: #eeeeec;
  font-size: 9px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--qs-gold);
}

.qs-product__review-meta {
  font-size: 12px;
  color: var(--qs-outline);
}

.qs-product__review-title {
  margin: 0 0 10px;
  font-size: 18px;
  font-weight: 500;
  line-height: 24px;
  letter-spacing: -0.01em;
  color: var(--qs-ink);
}

.qs-product__review-body {
  margin: 0 0 16px;
  font-size: 13px;
  line-height: 20px;
  color: var(--qs-muted);
}

.qs-product__review-vessel {
  margin: 0 0 16px;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--qs-outline);
}

.qs-product__review-helpful {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  margin: auto 0 0;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--qs-outline);
}

.qs-product__reviews-more {
  display: flex;
  justify-content: center;
  margin-top: 36px;
}

.qs-product__reviews-load {
  padding: 14px 28px;
  border: 1px solid #e2e3e1;
  background: #ffffff;
  font-family: inherit;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--qs-ink);
  cursor: pointer;
}

@media screen and (max-width: 989px) {
  .qs-product__layout {
    grid-template-columns: 1fr;
    gap: 32px;
  }

  .qs-product__gallery {
    position: static;
  }

  .qs-product__provenance {
    grid-template-columns: 1fr 1fr;
  }

  .qs-product__prov-copy {
    grid-column: 1 / -1;
  }

  .qs-product__title {
    font-size: 26px;
    line-height: 32px;
  }

  .qs-product__related-grid {
    grid-template-columns: 1fr 1fr;
  }

  .qs-product__related-title {
    font-size: 28px;
    line-height: 36px;
  }

  .qs-product__related-head {
    align-items: flex-start;
  }

  .qs-product__reviews-summary {
    grid-template-columns: 1fr;
  }

  .qs-product__reviews-cta {
    justify-content: flex-start;
  }

  .qs-product__reviews-grid {
    grid-template-columns: 1fr;
  }
}

@media screen and (max-width: 749px) {
  .qs-product__notes,
  .qs-product__variant-grid,
  .qs-product__related-grid {
    grid-template-columns: 1fr;
  }

  .qs-product__cta-row {
    flex-direction: column;
  }

  .qs-product__qty {
    width: 100%;
    justify-content: space-between;
  }
}
{% endstylesheet %}

