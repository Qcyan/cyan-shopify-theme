<script>
  (function () {
    var root = document.getElementById('qs-product-{{ section.id }}');
    if (!root) return;

    var qtyInput = root.querySelector('[data-qty-input]');
    var qtyDisplay = root.querySelector('[data-qty-display]');
    var variantInput = root.querySelector('[data-variant-id]');
    var priceEl = root.querySelector('[data-price]');
    var addLabel = root.querySelector('[data-add-label]');
    var mainImg = root.querySelector('#qs-product-main-img');

    function setQty(n) {
      n = Math.max(1, Math.min(99, n));
      if (qtyInput) qtyInput.value = String(n);
      if (qtyDisplay) qtyDisplay.textContent = String(n);
    }

    var minus = root.querySelector('[data-qty-minus]');
    var plus = root.querySelector('[data-qty-plus]');
    if (minus) minus.addEventListener('click', function () { setQty(parseInt(qtyInput.value, 10) - 1); });
    if (plus) plus.addEventListener('click', function () { setQty(parseInt(qtyInput.value, 10) + 1); });

    root.querySelectorAll('[data-variant-option]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        if (btn.disabled) return;
        root.querySelectorAll('[data-variant-option]').forEach(function (b) { b.classList.remove('is-active'); });
        btn.classList.add('is-active');
        var id = btn.getAttribute('data-id');
        var price = btn.getAttribute('data-price');
        if (variantInput && id) variantInput.value = id;
        if (priceEl && price) priceEl.textContent = price;
        if (addLabel && price) addLabel.textContent = 'Add To Bag — ' + price;
      });
    });

    root.querySelectorAll('.qs-product__thumb[data-full]').forEach(function (thumb) {
      thumb.addEventListener('click', function () {
        var full = thumb.getAttribute('data-full');
        if (mainImg && full) {
          if (mainImg.tagName === 'IMG') mainImg.src = full;
          else {
            var img = mainImg.querySelector('img') || mainImg;
            if (img && img.tagName === 'IMG') img.src = full;
          }
        }
      });
    });

    var monoToggle = root.querySelector('[data-mono-toggle]');
    var monoDrawer = root.querySelector('[data-mono-drawer]');
    var monoInput = root.querySelector('[data-mono-input]');
    if (monoToggle && monoDrawer) {
      monoToggle.addEventListener('change', function () {
        var on = monoToggle.checked;
        monoDrawer.hidden = !on;
        if (monoInput) {
          monoInput.disabled = !on;
          if (!on) monoInput.value = '';
        }
      });
    }
  })();
</script>

