{% comment %}
  PDP — 对齐 stitch/desktop-pdp.html
{% endcomment %}

{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'qs-product-form-' | append: section.id
  assign media_count = product.media.size
  assign subtitle = section.settings.subtitle
  if subtitle == blank and product.description != blank
    assign subtitle = product.description | strip_html | truncate: 90
  endif
%}

<section class="qs-product" id="qs-product-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="page-width qs-product__topbar">
    <nav class="qs-product__breadcrumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span aria-hidden="true">/</span>
      <a href="{{ routes.all_products_collection_url }}">Collections</a>
      <span aria-hidden="true">/</span>
      {% if collection %}
        <a href="{{ collection.url }}">{{ collection.title }}</a>
      {% else %}
        <span>{{ section.settings.breadcrumb_mid | default: 'Haute Parfumerie' }}</span>
      {% endif %}
      <span aria-hidden="true">/</span>
      <span class="qs-product__breadcrumb-current" aria-current="page">{{ product.title }}</span>
    </nav>

    <div class="qs-product__top-meta">
      {% if section.settings.edition_label != blank %}
        <span class="qs-product__top-edition">
          <span class="qs-product__top-dot" aria-hidden="true"></span>
          {{ section.settings.edition_label }}
        </span>
      {% endif %}
      {% if section.settings.origin_label != blank %}
        <span class="qs-product__top-sep" aria-hidden="true">·</span>
        <span>{{ section.settings.origin_label }}</span>
      {% endif %}
    </div>
  </div>

  <div class="page-width qs-product__layout">
    <div class="qs-product__gallery">
      <div class="qs-product__main-media">
        <span class="qs-product__plate">{{ section.settings.plate_main | default: 'Plate I — Extrait Flacon' }}</span>
        {% if product.featured_media %}
          {% assign main_alt = product.featured_media.alt | default: product.title %}
          {{
            product.featured_media
            | image_url: width: 1400
            | image_tag:
              class: 'qs-product__main-img',
              id: 'qs-product-main-img',
              loading: 'eager',
              widths: '600,900,1200,1400',
              sizes: '(min-width: 990px) 45vw, 100vw',
              alt: main_alt
          }}
        {% else %}
          <img
            class="qs-product__main-img"
            id="qs-product-main-img"
            src="https://lh3.googleusercontent.com/aida-public/AB6AXuAZPLmPPzFzFoNzPxIJFem-8vVlBqutqa4D6_yh4tF5xdtoe9NOsaRZbFWi0jkl-xLkkTpDuTZAAO3jZOPaolzCOmJRG38HdEbyWRa-oTt-nx9llfJ9kd6DhZKHjIibnIBGaHPkdYT7avj5Im23t8vXflj7fMh6_NVS9IUN9oeYGKEA6rZpeTriZRZs51APEycYCk9ThWhpD0AmaAFm3AFq7S3RE6uGDmssrV97r0k"
            alt="{{ product.title | escape }}"
            width="900"
            height="1125"
          >
        {% endif %}
        <span class="qs-product__zoom" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0016 9.5 6.5 6.5 0 109.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
          </svg>
        </span>
      </div>

      <div class="qs-product__thumbs">
        {% if media_count > 1 %}
          {% for media in product.media offset: 1 limit: 2 %}
            <button type="button" class="qs-product__thumb" data-full="{{ media | image_url: width: 1400 }}">
              {% assign thumb_alt = media.alt | default: product.title %}
              {{
                media
                | image_url: width: 600
                | image_tag: loading: 'lazy', alt: thumb_alt
              }}
              <span class="qs-product__thumb-label">
                {%- if forloop.first -%}
                  {{- section.settings.plate_2 | default: 'Plate II — Brass Seal' -}}
                {%- else -%}
                  {{- section.settings.plate_3 | default: 'Plate III — Ritual Application' -}}
                {%- endif -%}
              </span>
            </button>
          {% endfor %}
        {% endif %}
        {% if media_count < 2 %}
          <div class="qs-product__thumb" aria-hidden="true">
            <img
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuDwBXR75czZMihGQvjE5KzLiVKv92dt5FRqLW9F9T84rb50sOJCf7EZ3ibp7D5l-ugBS6H3H9qKML8XPSaH2ZADwqPIXIFWkVH_Zoj2Tq5eGz-UhYT9mH44VrnaCpQ9vLclcLnvK1-iNzV-wE_9m5ns0vyEPeLU3l9bDipxcZZmOK8ftX-bdOxTZqPFmtny94_I0PON1FJQiBRUKhkOsAmPzu8QFsCZapu3TahBGhA"
              alt=""
              loading="lazy"
              width="600"
              height="600"
            >
            <span class="qs-product__thumb-label">{{ section.settings.plate_2 | default: 'Plate II — Brass Seal' }}</span>
          </div>
        {% endif %}
        {% if media_count < 3 %}
          <div class="qs-product__thumb" aria-hidden="true">
            <img
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuAS1ACU4U3ByAjYOjXrY6P1ZJ-TovHd2A6846EdF9fPyZ8Nn1oSnJwokAlQiS7cYl-Wlru0lOIIK-Guk1_9m2iR2YifJuo5iBTz_DamxOzYR0bHBUrHvVN5iHdsbpN37sVYt86GRMnr1g7WtgwXOkWCo3KhUhcTPlEIZeg2Xtw9mdwLfPoXglxxqOMVr6fPjkBjCkpGrix1pkvBx3dAnIoTb4I1K_L59D91MgrZPcQ"
              alt=""
              loading="lazy"
              width="600"
              height="600"
            >
            <span class="qs-product__thumb-label">{{ section.settings.plate_3 | default: 'Plate III — Ritual Application' }}</span>
          </div>
        {% endif %}
      </div>

      <div class="qs-product__provenance">
        <div class="qs-product__prov-copy">
          <h3>{{ section.settings.prov_title | default: 'Botanical Provenance' }}</h3>
          <p>{{ section.settings.prov_text }}</p>
        </div>
        <div class="qs-product__stat">
          <span class="qs-product__stat-value">{{ section.settings.stat_1_value | default: '32%' }}</span>
          <span class="qs-product__stat-label">{{ section.settings.stat_1_label | default: 'Concentration' }}</span>
        </div>
        <div class="qs-product__stat">
          <span class="qs-product__stat-value">{{ section.settings.stat_2_value | default: '90 Days' }}</span>
          <span class="qs-product__stat-label">{{ section.settings.stat_2_label | default: 'Cold Maceration' }}</span>
        </div>
        <div class="qs-product__stat">
          <span class="qs-product__stat-value">{{ section.settings.stat_3_value | default: 'Zero' }}</span>
          <span class="qs-product__stat-label">{{ section.settings.stat_3_label | default: 'Synthetic Fixatives' }}</span>
        </div>
      </div>

    </div>

    <div class="qs-product__buy">
      <div class="qs-product__title-row">
        <div class="qs-product__title-lead">
          {% if section.settings.batch_label != blank %}
            <span class="qs-product__batch">{{ section.settings.batch_label }}</span>
          {% endif %}
          <h1 class="qs-product__title">{{ product.title }}</h1>
        </div>
        <span class="qs-product__bookmark" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M6 4h12a1 1 0 011 1v16l-7-4-7 4V5a1 1 0 011-1z"/>
          </svg>
        </span>
      </div>

      {% if subtitle != blank %}
        <p class="qs-product__subtitle">{{ subtitle }}</p>
      {% endif %}

      <div class="qs-product__rating">
        <span class="qs-product__stars" aria-hidden="true">★★★★★</span>
        <span>{{ section.settings.rating_score | default: '4.9' }}</span>
        <a class="qs-product__rating-count" href="#patron-reviews">
          · {{ section.settings.rating_count | default: '318' }} Patron Notes
        </a>
      </div>

      <div class="qs-product__price-block">
        <span class="qs-product__price" data-price>
          {{ current_variant.price | money }}
        </span>
        <span class="qs-product__price-note">USD / Taxes Included</span>
      </div>

      <div class="qs-product__stock">
        <span class="qs-product__stock-icon" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/>
          </svg>
        </span>
        <div>
          <strong>{{ section.settings.stock_title | default: 'In Stock & Vault Prepared.' }}</strong>
          <p>{{ section.settings.stock_text }}</p>
        </div>
      </div>

      <div class="qs-product__olfactory">
        <div class="qs-product__olfactory-head">
          <h3>Olfactory Architecture</h3>
          <span class="qs-product__longevity">{{ section.settings.longevity | default: 'Longevity: 14+ Hrs' }}</span>
        </div>
        <div class="qs-product__notes">
          <div class="qs-product__note-card">
            <span class="qs-product__note-label">Top</span>
            <span class="qs-product__note-main">{{ section.settings.note_top_1 | default: 'Green Cardamom' }}</span>
            <span class="qs-product__note-sub">{{ section.settings.note_top_2 | default: 'Fig Leaf Extract' }}</span>
          </div>
          <div class="qs-product__note-card">
            <span class="qs-product__note-label">Heart</span>
            <span class="qs-product__note-main">{{ section.settings.note_heart_1 | default: 'Orris Root' }}</span>
            <span class="qs-product__note-sub">{{ section.settings.note_heart_2 | default: 'Smoked Papyrus' }}</span>
          </div>
          <div class="qs-product__note-card">
            <span class="qs-product__note-label">Base</span>
            <span class="qs-product__note-main">{{ section.settings.note_base_1 | default: 'Mysore Sandal' }}</span>
            <span class="qs-product__note-sub">{{ section.settings.note_base_2 | default: 'Golden Amber Tears' }}</span>
          </div>
        </div>
      </div>

      {% form 'product', product, id: product_form_id, class: 'qs-product__form' %}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

        <div class="qs-product__variants">
          <div class="qs-product__variants-head">
            <h3>{{ section.settings.volume_label | default: 'Select Volume Vessel' }}</h3>
            <span class="qs-product__variants-hint">{{ section.settings.volume_hint | default: '50ml / 1.7 fl. oz. Extrait' }}</span>
          </div>
          <div class="qs-product__variant-grid" role="listbox" aria-label="Volume">
            {% if product.variants.size > 1 %}
              {% for variant in product.variants %}
                <button
                  type="button"
                  class="qs-product__variant{% if variant.id == current_variant.id %} is-active{% endif %}"
                  data-variant-option
                  data-id="{{ variant.id }}"
                  data-price="{{ variant.price | money }}"
                  data-available="{{ variant.available }}"
                  {% unless variant.available %}
                    disabled
                  {% endunless %}
                >
                  <span class="qs-product__variant-size">{{ variant.title }}</span>
                  <span class="qs-product__variant-price">{{ variant.price | money }}</span>
                </button>
              {% endfor %}
            {% else %}
              <button type="button" class="qs-product__variant is-active" data-variant-option data-id="{{ current_variant.id }}" data-price="{{ current_variant.price | money }}">
                <span class="qs-product__variant-size">50ml</span>
                <span class="qs-product__variant-price">{{ current_variant.price | money }}</span>
              </button>
              <button type="button" class="qs-product__variant" disabled>
                <span class="qs-product__variant-size">30ml</span>
                <span class="qs-product__variant-price">$135</span>
              </button>
              <button type="button" class="qs-product__variant" disabled>
                <span class="qs-product__variant-size">100ml</span>
                <span class="qs-product__variant-price">$295</span>
              </button>
            {% endif %}
          </div>
        </div>

        {% if section.settings.show_monogram %}
          <div class="qs-product__mono" data-mono>
            <div class="qs-product__mono-bar">
              <div class="qs-product__mono-copy">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1.003 1.003 0 000-1.42l-2.34-2.34a1.003 1.003 0 00-1.42 0l-1.83 1.83 3.75 3.75 1.84-1.82z"/>
                </svg>
                <div>
                  <span class="qs-product__mono-title">Complimentary Monogramming</span>
                  <span class="qs-product__mono-sub">Gold hot-stamp on crystal face plate</span>
                </div>
              </div>
              <label class="qs-product__toggle">
                <input type="checkbox" data-mono-toggle aria-label="Enable monogramming">
                <span class="qs-product__toggle-track" aria-hidden="true"></span>
              </label>
            </div>
            <div class="qs-product__mono-drawer" data-mono-drawer hidden>
              <div class="qs-product__monogram-row">
                <input
                  class="qs-product__mono-input"
                  type="text"
                  name="properties[Monogram]"
                  maxlength="3"
                  placeholder="Initials (Up to 3 Letters)"
                  aria-label="Monogram initials"
                  data-mono-input
                  disabled
                >
                <span class="qs-product__mono-free">Free of Charge</span>
              </div>
            </div>
          </div>
        {% endif %}

        <div class="qs-product__trial">
          <div class="qs-product__trial-head">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/>
            </svg>
            Risk-Free Olfactory Trial Protocol
          </div>
          <p>{{ section.settings.trial_text }}</p>
        </div>

        <div class="qs-product__cta-row">
          <div class="qs-product__qty">
            <button type="button" data-qty-minus aria-label="Decrease quantity">−</button>
            <span class="qs-product__qty-value" data-qty-display>1</span>
            <input type="hidden" name="quantity" value="1" data-qty-input>
            <button type="button" data-qty-plus aria-label="Increase quantity">+</button>
          </div>
          <button
            type="submit"
            class="qs-product__add"
            data-add-btn
            {% unless current_variant.available %}
              disabled
            {% endunless %}
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.15.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49A1.003 1.003 0 0020 4H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"/>
            </svg>
            <span data-add-label>Add To Bag — {{ current_variant.price | money }}</span>
          </button>
        </div>
      {% endform %}

      <p class="qs-product__ship-note">
        {{ section.settings.shipping_note | default: 'Complimentary tracked courier shipping & insured global transit.' }}
      </p>

      <div class="qs-product__accords">
        <details class="qs-product__accord" open>
          <summary>
            Olfactory Notes &amp; Botanical Sourcing
            <span class="qs-product__accord-icon" aria-hidden="true">▾</span>
          </summary>
          <div class="qs-product__accord-body">
            {{ section.settings.accord_notes | newline_to_br }}
          </div>
        </details>
        <details class="qs-product__accord">
          <summary>
            Ritual &amp; Diffusion Guide
            <span class="qs-product__accord-icon" aria-hidden="true">▾</span>
          </summary>
          <div class="qs-product__accord-body">
            {{ section.settings.accord_ritual | newline_to_br }}
          </div>
        </details>
        <details class="qs-product__accord">
          <summary>
            Complimentary Casing &amp; Shipping
            <span class="qs-product__accord-icon" aria-hidden="true">▾</span>
          </summary>
          <div class="qs-product__accord-body">
            {{ section.settings.accord_shipping | newline_to_br }}
          </div>
        </details>
        <details class="qs-product__accord">
          <summary>
            30-Day Effortless Returns
            <span class="qs-product__accord-icon" aria-hidden="true">▾</span>
          </summary>
          <div class="qs-product__accord-body">
            {{ section.settings.accord_returns | newline_to_br }}
          </div>
        </details>
      </div>
    </div>
  </div>

  <div class="qs-product__related">
    <div class="page-width">
      <div class="qs-product__related-head">
        <div class="qs-product__related-lead">
          <p class="qs-product__related-eyebrow">{{ section.settings.related_eyebrow | default: 'Harmonious Layering' }}</p>
          <h2 class="qs-product__related-title">{{ section.settings.related_title | default: 'Complete The Daily Ritual' }}</h2>
        </div>
        <p class="qs-product__related-desc">
          {{ section.settings.related_desc }}
        </p>
      </div>
      <div class="qs-product__related-grid">
      {% assign related = section.settings.related_collection %}
      {% if related != blank and related.products.size > 0 %}
        {% for item in related.products limit: 3 %}
          {% render 'qs-product-card', product: item, variant: 'collection' %}
        {% endfor %}
      {% else %}
        {% render 'qs-product-card',
          demo: true,
          variant: 'collection',
          badge: 'Ritual Oil',
          notes: '100ml — Cold Pressed',
          title: 'Santal Nectar Botanical Body Oil',
          description: 'Jojoba, squalane and golden sandalwood extract',
          price: '$88',
          image_url: 'https://lh3.googleusercontent.com/aida-public/AB6AXuDtSbT74DKrRjoPVim0VLky1JPY_uzWq-50bJdZrNo-ydU3Jq7GZx4wQelmW0lT47E0xcok2A8waAA4Llkw8C4XcGrBwbDUVlNjOUJmvjw6N460EoLDUUbgCcgq1lWzGgDnJSTSz1V1bS_WshERSAXKBCQiTVSM3V-UjLc9YiAyFXzSl_V23cxPpkfSwBliIpnZFj7_yq9CCaKlOzJ6ATBL3SdCDcC6pRSK-Wu8kyY'
        %}
        {% render 'qs-product-card',
          demo: true,
          variant: 'collection',
          badge: 'Home Object',
          notes: 'Solid Bronze — Kyoto Made',
          title: 'Cast Bronze Incense Dish',
          description: 'Hand-poured in Kyoto for cedar and sandalwood ash',
          price: '$145',
          image_url: 'https://lh3.googleusercontent.com/aida-public/AB6AXuClOu2r_RiJoZAmpZvQq9_9RxvTlQb9f3VccmiqpIB7XGLV-Vs_aeU3VFfBdYutV89qqMDTwOOh-18_MagbWApSlOYS_F3CdXf49tuY9OkUIjzZEwGh6U4evXF9r1cTUyAwgvrwTYpNuD1BYDgBsSqA46EmBcf9kk6SSrB6FMWxFj2NgzC3LsD1aZuR3bA2rnX6H73In9Li9_A90IgzgBUrBmIBqkBBVDpR9XrMijQ'
        %}
        {% render 'qs-product-card',
          demo: true,
          variant: 'collection',
          badge: 'Accessory',
          notes: 'Linen Travel Case',
          title: 'Debossed Flacon Sleeve',
          description: 'Soft linen sleeve for 50ml and 100ml vessels',
          price: '$42',
          image_url: 'https://lh3.googleusercontent.com/aida-public/AB6AXuBVuurbQe8VXrgkHhBXrB8kdKHBo0CkAgr2DuPRKJMS3dzwVqNkbkE6gCxEIkzCLNdnagsapYUkcqDF0WV4KZZ-_iOVpXKkSpTjYevm3vlDp0xYW58jdOScwPFD2wgpFYvvq808Z4BEgkQHKxqym5Z35_6m8QvyhTAGqDvTBFUuO_krHETypODfsZzuS0SC3IxUeAMtiLyT5DXxWu6X4UR7aAIs2smOT7gIevpKERk'
        %}
      {% endif %}
      </div>
    </div>
  </div>

  <div class="page-width qs-product__reviews" id="patron-reviews">
    <div class="qs-product__reviews-summary">
      <div class="qs-product__reviews-score">
        <span class="qs-product__reviews-score-num">{{ section.settings.rating_score | default: '4.9' }}</span>
        <span class="qs-product__reviews-stars" aria-hidden="true">★★★★★</span>
        <span class="qs-product__reviews-score-meta">
          Based on {{ section.settings.rating_count | default: '318' }} Verified Orders
        </span>
      </div>

      <div class="qs-product__reviews-metrics">
        <div class="qs-product__metric">
          <div class="qs-product__metric-row">
            <span>{{ section.settings.metric_1_label | default: 'Skin Longevity: 12h+' }}</span>
            <span>{{ section.settings.metric_1_pct | default: '94% Patrons' }}</span>
          </div>
          <div class="qs-product__metric-track">
            <span class="qs-product__metric-fill" style="width: {{ section.settings.metric_1_width | default: 94 }}%"></span>
          </div>
        </div>
        <div class="qs-product__metric">
          <div class="qs-product__metric-row">
            <span>{{ section.settings.metric_2_label | default: 'Projection & Sillage: Intimate-to-Moderate' }}</span>
            <span>{{ section.settings.metric_2_pct | default: '89% Patrons' }}</span>
          </div>
          <div class="qs-product__metric-track">
            <span class="qs-product__metric-fill" style="width: {{ section.settings.metric_2_width | default: 89 }}%"></span>
          </div>
        </div>
        <div class="qs-product__metric">
          <div class="qs-product__metric-row">
            <span>{{ section.settings.metric_3_label | default: 'Recommend / Would Re-Order' }}</span>
            <span>{{ section.settings.metric_3_pct | default: '97% Patrons' }}</span>
          </div>
          <div class="qs-product__metric-track">
            <span class="qs-product__metric-fill" style="width: {{ section.settings.metric_3_width | default: 97 }}%"></span>
          </div>
        </div>
      </div>

      <div class="qs-product__reviews-cta">
        <button type="button" class="qs-product__reviews-submit">Submit Patron Note</button>
      </div>
    </div>

    <div class="qs-product__reviews-filters">
      <div class="qs-product__filter-chips">
        <button type="button" class="qs-product__chip is-active">All Notes (318)</button>
        <button type="button" class="qs-product__chip">With Flacon Photos (64)</button>
        <button type="button" class="qs-product__chip">Longevity 12h+ (280)</button>
