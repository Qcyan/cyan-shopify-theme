{% comment %}
  Footer — 含 The Olfactory Gazette（设计稿页脚订阅）
{% endcomment %}

<footer class="qs-footer">
  <div class="qs-footer__inner page-width">
    <div class="qs-footer__gazette">
      {% if section.settings.gazette_title != blank %}
        <h3 class="qs-footer__gazette-title">{{ section.settings.gazette_title }}</h3>
      {% endif %}
      {% if section.settings.gazette_text != blank %}
        <p class="qs-footer__gazette-text">{{ section.settings.gazette_text }}</p>
      {% endif %}
      {% form 'customer', class: 'qs-footer__form' %}
        <input type="hidden" name="contact[tags]" value="newsletter,olfactory-gazette">
        <label class="visually-hidden" for="QsFooterEmail-{{ section.id }}">Email</label>
        <input
          id="QsFooterEmail-{{ section.id }}"
          class="qs-footer__input"
          type="email"
          name="contact[email]"
          value="{{ form.email }}"
          placeholder="{{ section.settings.gazette_placeholder }}"
          required
          autocomplete="email"
        >
        <button type="submit" class="qs-footer__submit" name="commit">
          {{ section.settings.gazette_button }}
        </button>
      {% endform %}
    </div>

    <div class="qs-footer__menus">
      {% for block in section.blocks %}
        <div class="qs-footer__col" {{ block.shopify_attributes }}>
          {% if block.settings.heading != blank %}
            <p class="qs-footer__heading">{{ block.settings.heading }}</p>
          {% endif %}
          {% if block.settings.menu != blank %}
            <ul class="qs-footer__list">
              {% for link in block.settings.menu.links %}
                <li>
                  <a href="{{ link.url }}">{{ link.title }}</a>
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>

  <div class="qs-footer__bottom page-width">
    <p class="qs-footer__copyright">
      &copy; {{ 'now' | date: '%Y' }}
      {{ section.settings.copyright | default: shop.name }}
    </p>
  </div>
</footer>

{% stylesheet %}
/* Footer + Olfactory Gazette — px */

.qs-footer {
  padding: 72px 0 28px;
  background: #f4f4f2;
  color: #444748;
  border-top: 1px solid #eae6df;
  font-family: 'Inter', system-ui, sans-serif;
}

.qs-footer__inner {
  display: grid;
  grid-template-columns: 1.4fr 1fr;
  gap: 48px;
  padding-bottom: 48px;
  border-bottom: 1px solid #eae6df;
}

.qs-footer__gazette-title {
  margin: 0 0 10px;
  font-size: 18px;
  font-weight: 500;
  line-height: 24px;
  letter-spacing: -0.01em;
  color: #2a2a2a;
}

.qs-footer__gazette-text {
  margin: 0 0 20px;
  max-width: 22rem;
  font-size: 12px;
  line-height: 18px;
  color: #444748;
}

.qs-footer__form {
  display: flex;
  max-width: 28rem;
  border: 1px solid #eae6df;
  background: #fff;
}

.qs-footer__input {
  flex: 1;
  min-height: 48px;
  padding: 0 16px;
  border: 0;
  font-family: inherit;
  font-size: 12px;
  color: #2a2a2a;
}

.qs-footer__input:focus {
  outline: none;
}

.qs-footer__submit {
  flex: 0 0 auto;
  min-height: 48px;
  padding: 0 20px;
  border: 0;
  border-left: 1px solid #eae6df;
  background: #2a2a2a;
  color: #fafaf8;
  font-family: inherit;
  font-size: 12px;
  font-weight: 500;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  cursor: pointer;
}

.qs-footer__menus {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24px;
}

.qs-footer__heading {
  margin: 0 0 16px;
  font-size: 12px;
  font-weight: 500;
  line-height: 16px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: #2a2a2a;
}

.qs-footer__list {
  margin: 0;
  padding: 0;
  list-style: none;
}

.qs-footer__list li + li {
  margin-top: 10px;
}

.qs-footer__list a {
  color: #444748;
  text-decoration: none;
  font-size: 12px;
  line-height: 18px;
}

.qs-footer__list a:hover {
  color: #2a2a2a;
}

.qs-footer__bottom {
  padding-top: 24px;
}

.qs-footer__copyright {
  margin: 0;
  font-size: 12px;
  color: #747878;
}

@media (max-width: 749px) {
  .qs-footer__inner {
    grid-template-columns: 1fr;
    gap: 36px;
  }

  .qs-footer__form {
    flex-direction: column;
  }

  .qs-footer__submit {
    border-left: 0;
    border-top: 1px solid #eae6df;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "轻奢页脚",
  "tag": "section",
  "class": "section-qs-footer",
  "settings": [
    {
      "type": "text",
      "id": "gazette_title",
      "label": "Gazette 标题",
      "default": "The Olfactory Gazette"
    },
    {
      "type": "textarea",
      "id": "gazette_text",
      "label": "Gazette 说明",
      "default": "Receive invitations to private seasonal salons, olfactory compositions, and discreet archival releases."
    },
    {
      "type": "text",
      "id": "gazette_placeholder",
      "label": "邮箱占位",
      "default": "Your email address"
    },
    {
      "type": "text",
      "id": "gazette_button",
      "label": "订阅按钮",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "版权后缀",
      "default": "Atelier Maison. All rights reserved."
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "菜单列",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "列标题",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "菜单"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "轻奢页脚",
      "blocks": [
        { "type": "menu", "settings": { "heading": "Shop" } },
        { "type": "menu", "settings": { "heading": "Help" } }
      ]
    }
  ]
}
{% endschema %}
