          price: '$120',
          rating_count: '32',
          meta_label: 'Handcrafted',
          image_url: 'https://lh3.googleusercontent.com/aida-public/AB6AXuAPEQ4uiN-7bT17h1f1IycpvMeopcAgv9QfSccnAULYfOIisJX1O7PyK8QSUi5aiSBi2lOt3y9lMChaBuQjyEaxOaCB-4n1pioeoCZ1e4A_8dggaKSA3h7O5VHua9Tz1TbIr1c0qwDaw667TX5VnXOyYdqJ8PubIvcL20goDZwBZy38fIK1EhPZ2jwqTirjPU4DYd-BEXudsVEW4XNbGq64bWJ340d4VbBAdHqZcoo'
        %}
        {% render 'qs-product-card',
          demo: true,
