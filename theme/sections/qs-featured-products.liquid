{% comment %}
  Signature Acquisitions — 对齐 stitch Desktop 首页商品区
{% endcomment %}

{% liquid
  assign collection = section.settings.collection
  assign products_to_show = section.settings.products_to_show | default: 4
  assign has_products = false
  if collection != blank and collection.products.size > 0
    assign has_products = true
  endif
%}

<section class="qs-featured">
  <div class="page-width">
    <div class="qs-featured__header">
      <div class="qs-featured__heading-wrap">
        {% if section.settings.eyebrow != blank %}
          <p class="qs-featured__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        {% if section.settings.title != blank %}
          <h2 class="qs-featured__title">{{ section.settings.title }}</h2>
        {% endif %}
      </div>

      <nav class="qs-featured__tabs" aria-label="Product filters">
        {% if section.settings.tab_1 != blank %}
          <a
            href="{{ collection.url | default: routes.all_products_collection_url }}"
            class="qs-featured__tab qs-featured__tab--active"
          >
            {{- section.settings.tab_1 -}}
          </a>
        {% endif %}
        {% if section.settings.tab_2 != blank %}
          <span class="qs-featured__tab">{{ section.settings.tab_2 }}</span>
        {% endif %}
        {% if section.settings.tab_3 != blank %}
          <span class="qs-featured__tab">{{ section.settings.tab_3 }}</span>
        {% endif %}
      </nav>
    </div>

    <div class="qs-featured__grid">
      {% if has_products %}
        {% for product in collection.products limit: products_to_show %}
          {% render 'qs-product-card',
            product: product,
            badge: product.metafields.custom.badge,
            rating_count: product.metafields.reviews.rating_count
          %}
        {% endfor %}
      {% else %}
        {% comment %} 设计稿示意卡（无集合或空集合时） {% endcomment %}
        {% render 'qs-product-card',
          demo: true,
          badge: 'Best Seller',
          title: 'N° 07 Santal Nectar',
          description: 'Australian Sandalwood, Cardamom Pods & Dry Amber',
          price: '$185',
          rating_count: '48',
          variant_a: '50ml',
          variant_b: '100ml',
          variant_active: 'a',
          image_url: 'https://lh3.googleusercontent.com/aida-public/AB6AXuAqgPCcZdPAOfBirVXNmzh1eVHmakLmEDkhlav8Ab27z8tSYPHaei86chO8ReTlkLGvCb75x6G1zb3ec1ce_BpW9FRiGF1cP758r1fxkZZjpvLMKfZxrAhzE8inLzgsV75DW7y13z061NhmCJPldvElFLGo3pqE6dfAeAEiHM9OHcSmEzHzk5uFN42a3DIQj303lqIMziocCwMA3rvEgBqe1VRuRUIozJuHt1WGyXg'
        %}
        {% render 'qs-product-card',
          demo: true,
