<script>
  (function () {
    var root = document.getElementById('qs-collection-{{ section.id }}');
    if (!root) return;
    var grid = root.querySelector('[data-grid]');
    var buttons = root.querySelectorAll('.qs-collection__view-btn');
    buttons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var cols = btn.getAttribute('data-cols');
        root.setAttribute('data-columns', cols);
        buttons.forEach(function (b) {
          var on = b === btn;
          b.classList.toggle('is-active', on);
          b.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
        if (grid) grid.dataset.cols = cols;
      });
    });
  })();
</script>

{% schema %}
{
  "name": "系列列表 Permanent",
  "tag": "section",
  "class": "section-qs-collection",
  "settings": [
    {
      "type": "text",
      "id": "breadcrumb_current",
      "label": "面包屑当前项",
      "default": "Permanent Series"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "眉题",
      "default": "Vol. IV — Kyoto & Grasse Atelier"
    },
    {
      "type": "text",
      "id": "grade_label",
      "label": "等级标签",
      "default": "Archival Grade"
    },
    {
      "type": "text",
      "id": "title",
      "label": "标题（空则用集合名）",
      "default": "The Permanent Collection"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "描述（空则用集合描述）",
      "default": "Curated sensorial fragrances, pure mineral vessels, and timeless ritual objects crafted for mindful contemplation."
    },
    {
      "type": "text",
      "id": "creations_label",
      "label": "数量后缀",
      "default": "Creations"
    },
    {
      "type": "text",
      "id": "meta_line",
      "label": "统计副文案",
      "default": "Ethically Foraged Botanicals"
    },
    {
