{% comment %}
  Sensory Realms — stitch §5 三域卡片
{% endcomment %}

<section class="qs-realms">
  <div class="page-width">
    <header class="qs-realms__header">
      {% if section.settings.eyebrow != blank %}
        <p class="qs-realms__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% if section.settings.title != blank %}
        <h2 class="qs-realms__title">{{ section.settings.title }}</h2>
      {% endif %}
      {% if section.settings.subtitle != blank %}
        <p class="qs-realms__subtitle">{{ section.settings.subtitle }}</p>
      {% endif %}
    </header>

    <div class="qs-realms__grid">
      {% for block in section.blocks %}
        <article class="qs-realms__card" {{ block.shopify_attributes }}>
          <div class="qs-realms__media">
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  sizes: '(min-width: 990px) 33vw, 100vw',
                  widths: '400, 800, 1200',
                  class: 'qs-realms__img',
                  alt: block.settings.title
              }}
            {% elsif block.settings.fallback_image != blank %}
              <img
                class="qs-realms__img"
                src="{{ block.settings.fallback_image }}"
                alt="{{ block.settings.title | escape }}"
                loading="lazy"
                width="800"
                height="1000"
              >
            {% else %}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'qs-realms__img' }}
            {% endif %}
          </div>
          <div class="qs-realms__overlay">
            {% if block.settings.domain != blank %}
              <p class="qs-realms__domain">{{ block.settings.domain }}</p>
            {% endif %}
            {% if block.settings.title != blank %}
              <h3 class="qs-realms__card-title">{{ block.settings.title }}</h3>
            {% endif %}
            {% if block.settings.text != blank %}
              <p class="qs-realms__card-text">{{ block.settings.text }}</p>
            {% endif %}
            {% if block.settings.link_label != blank %}
              <a class="qs-realms__link" href="{{ block.settings.link | default: '#' }}">
                {{ block.settings.link_label }}
                <span aria-hidden="true">→</span>
              </a>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

