{% comment %}
  Hero — 严格对齐 stitch/desktop-home.html（左文右图 + 图底信息条 + 浮动评语卡）
{% endcomment %}

{% liquid
  assign hero_image_fallback = 'https://lh3.googleusercontent.com/aida-public/AB6AXuC3B_X36UBoCP3NjIjXDACbqvpbfU09kXVyIRWsFaRP3MmcRJt-VSbWajLpWa1DtP_ozAbGUIKstHM_88Ikyq8yPHebb_Ih_-0IzM6-Aho_aSb_q7GItGr3Hh1KpjQt5myuPms3rMKDYwKNgbpNCUwbWTY99Ppcf1OI5sm5I8VDtjy0LMOu3UNqJbvy-iKYf0zdCnJsGzU3ff7EGiYphwVzNWkuP7sg3D4nU1lfHi4'
%}

<section
  class="hero-banner"
  style="background-color: {{ section.settings.bg_color }}"
>
  <div class="hero-banner__shell page-width">
    <div class="hero-banner__inner">
      <div class="hero-banner__content">
        {% if section.settings.eyebrow != blank %}
          <div class="hero-banner__eyebrow-row">
            <span class="hero-banner__eyebrow-line" aria-hidden="true"></span>
            <p class="hero-banner__eyebrow">{{ section.settings.eyebrow }}</p>
          </div>
        {% endif %}

        <h1 class="hero-banner__title">
          {{ section.settings.title }}
          {% if section.settings.title_italic != blank %}
            <span class="hero-banner__title-italic">{{ section.settings.title_italic }}</span>
          {% endif %}
        </h1>

        {% if section.settings.desc != blank %}
          <p class="hero-banner__desc">{{ section.settings.desc }}</p>
        {% endif %}

        <div class="hero-banner__actions">
          {% if section.settings.button_text != blank %}
            <a
              href="{{ section.settings.link | default: routes.all_products_collection_url }}"
              class="button hero-banner__cta"
            >
              {{- section.settings.button_text -}}
            </a>
          {% endif %}
          {% if section.settings.secondary_text != blank %}
            <a
              href="{{ section.settings.secondary_link | default: '#' }}"
              class="hero-banner__text-link"
            >
              <span>{{ section.settings.secondary_text }}</span>
              <span class="hero-banner__text-link-arrow" aria-hidden="true">→</span>
            </a>
          {% endif %}
        </div>

        {% if section.settings.show_stats %}
          <div class="hero-banner__stats">
            {% if section.settings.stat_1_label != blank %}
              <div class="hero-banner__stat">
                <span class="hero-banner__stat-value">{{ section.settings.stat_1_value }}</span>
                <span class="hero-banner__stat-label">{{ section.settings.stat_1_label }}</span>
              </div>
            {% endif %}
            {% if section.settings.stat_2_label != blank %}
              <div class="hero-banner__stat">
                <span class="hero-banner__stat-value">{{ section.settings.stat_2_value }}</span>
                <span class="hero-banner__stat-label">{{ section.settings.stat_2_label }}</span>
              </div>
            {% endif %}
            {% if section.settings.stat_3_label != blank %}
              <div class="hero-banner__stat">
                <span class="hero-banner__stat-value">{{ section.settings.stat_3_value }}</span>
                <span class="hero-banner__stat-label">{{ section.settings.stat_3_label }}</span>
              </div>
            {% endif %}
          </div>
        {% endif %}
      </div>

      <div class="hero-banner__media-wrap">
        <div class="hero-banner__media">
          {% if section.settings.image != blank %}
            {{
              section.settings.image
              | image_url: width: 1800
              | image_tag:
                loading: 'eager',
                sizes: '(min-width: 990px) 50vw, 100vw',
                widths: '600, 900, 1200, 1600, 1800',
                class: 'hero-banner__img',
                alt: section.settings.title
            }}
          {% else %}
            <img
              class="hero-banner__img"
              src="{{ hero_image_fallback }}"
              alt="{{ section.settings.title | escape }}"
              width="1200"
              height="1500"
              loading="eager"
            >
          {% endif %}

          {% if section.settings.media_caption != blank or section.settings.media_price != blank %}
            <div class="hero-banner__media-caption">
              <div class="hero-banner__media-caption-copy">
                {% if section.settings.media_label != blank %}
                  <p class="hero-banner__media-label">{{ section.settings.media_label }}</p>
                {% endif %}
                {% if section.settings.media_caption != blank %}
                  <p class="hero-banner__media-caption-title">{{ section.settings.media_caption }}</p>
                {% endif %}
              </div>
              {% if section.settings.media_price != blank %}
                <span class="hero-banner__media-price">{{ section.settings.media_price }}</span>
              {% endif %}
            </div>
          {% endif %}
        </div>

        {% if section.settings.quote_title != blank or section.settings.quote_text != blank %}
          <aside class="hero-banner__quote">
            {% if section.settings.quote_title != blank %}
              <p class="hero-banner__quote-title">
                <span class="hero-banner__quote-star" aria-hidden="true">★</span>
                {{ section.settings.quote_title }}
              </p>
            {% endif %}
            {% if section.settings.quote_text != blank %}
              <p class="hero-banner__quote-text">{{ section.settings.quote_text }}</p>
            {% endif %}
          </aside>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero 首屏Banner",
  "tag": "section",
  "class": "section-hero-banner",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "眉题",
      "default": "Edition Printemps — 2025 Release"
    },
    {
      "type": "text",
      "id": "title",
      "label": "主标题第一行",
      "default": "The Sculpted"
    },
    {
      "type": "text",
      "id": "title_italic",
      "label": "主标题斜体行",
      "default": "Botanicals"
    },
    {
      "type": "textarea",
      "id": "desc",
      "label": "描述",
      "default": "Artisanal Extrait de Parfum and tactile ritual objects. Distilled by hand across ancient Grasse harvests and cured in Kyoto cedarwood shrines."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "右侧主图（空则用设计稿示意）"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "背景色",
      "default": "#F4F4F2"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "主按钮",
      "default": "Explore The Collection"
    },
    {
      "type": "url",
      "id": "link",
      "label": "主按钮链接"
    },
    {
      "type": "text",
      "id": "secondary_text",
      "label": "次按钮文案",
      "default": "Discover The Craft"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "次按钮链接"
    },
    {
      "type": "header",
      "content": "图片角标"
    },
    {
      "type": "text",
      "id": "media_label",
      "label": "角标眉题",
      "default": "Flask Profile"
    },
    {
      "type": "text",
      "id": "media_caption",
      "label": "角标标题",
      "default": "Extrait de Nuit — Lot 18"
    },
    {
      "type": "text",
      "id": "media_price",
      "label": "角标价格",
      "default": "$240"
    },
    {
      "type": "header",
      "content": "浮动评语卡"
    },
    {
      "type": "text",
      "id": "quote_title",
      "label": "评语标题",
      "default": "Master Perfumer's Batch"
    },
    {
      "type": "textarea",
      "id": "quote_text",
      "label": "评语文案",
      "default": "\"A velvet smoke veiled in aged cypress oil, created for reverent contemplation.\""
    },
    {
      "type": "header",
      "content": "数据条"
    },
    {
      "type": "checkbox",
      "id": "show_stats",
      "label": "显示数据条",
      "default": true
    },
    {
      "type": "text",
      "id": "stat_1_value",
      "label": "数据1",
      "default": "06 Mo."
    },
    {
      "type": "text",
      "id": "stat_1_label",
      "label": "数据1说明",
      "default": "Cold Maturation"
    },
    {
      "type": "text",
      "id": "stat_2_value",
      "label": "数据2",
      "default": "100%"
    },
    {
      "type": "text",
      "id": "stat_2_label",
      "label": "数据2说明",
      "default": "Solvent Free"
    },
    {
      "type": "text",
      "id": "stat_3_value",
      "label": "数据3",
      "default": "N° 450"
    },
    {
      "type": "text",
      "id": "stat_3_label",
      "label": "数据3说明",
      "default": "Numbered Flasks"
    }
  ],
  "presets": [{ "name": "Hero 首屏Banner" }]
}
{% endschema %}
