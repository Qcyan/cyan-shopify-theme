{% comment %}
  Hero Banner — 源码路径: src/sections/marketing/hero-banner/
  构建后输出: theme/sections/hero-banner.liquid
{% endcomment %}

{{ 'section-hero-banner.css' | asset_url | stylesheet_tag }}

<div class="hero-banner" style="background-color: {{ section.settings.bg_color }}">
  <div class="hero-banner__inner page-width">
    <div class="hero-banner__content">
      <h1 class="hero-banner__title">{{ section.settings.title }}</h1>
      <p class="hero-banner__desc">{{ section.settings.desc }}</p>
      {% if section.settings.button_text != blank %}
        <a href="{{ section.settings.link }}" class="hero-banner__btn">
          {{- section.settings.button_text -}}
        </a>
      {% endif %}
    </div>
    {% if section.settings.image != blank %}
      <div class="hero-banner__media">
        {{
          section.settings.image
          | image_url: width: 1400
          | image_tag: loading: 'eager', sizes: '(min-width: 750px) 50vw, 100vw', widths: '400, 800, 1200, 1400'
        }}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Hero 首屏Banner",
  "tag": "section",
  "class": "section-hero-banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner图片"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "背景色",
      "default": "#FAFAF8"
    },
    {
      "type": "text",
      "id": "title",
      "label": "主标题",
      "default": "Crafted for Everyday Elegance"
    },
    {
      "type": "textarea",
      "id": "desc",
      "label": "描述文字",
      "default": "Handpicked premium pieces, designed to fit your quiet luxury lifestyle."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "按钮文字",
      "default": "Shop Collection"
    },
    {
      "type": "url",
      "id": "link",
      "label": "按钮跳转链接"
    }
  ],
  "presets": [
    {
      "name": "Hero 首屏Banner"
    }
  ]
}
{% endschema %}
