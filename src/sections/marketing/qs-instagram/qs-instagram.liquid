{% comment %}
  Instagram 社交墙 — 手动上传图片（作品集无需接 IG API）
{% endcomment %}

<section class="qs-instagram">
  <div class="page-width">
    <div class="qs-instagram__header">
      {% if section.settings.title != blank %}
        <h2 class="qs-section-heading">{{ section.settings.title }}</h2>
      {% endif %}
      {% if section.settings.subtitle != blank %}
        <p class="qs-section-subheading">{{ section.settings.subtitle }}</p>
      {% endif %}
      {% if section.settings.instagram_url != blank %}
        <a class="qs-instagram__link" href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener">
          {{ section.settings.instagram_label }}
        </a>
      {% endif %}
    </div>

    <div class="qs-instagram__grid">
      {% for block in section.blocks %}
        <div class="qs-instagram__item" {{ block.shopify_attributes }}>
          {% if block.settings.link != blank %}
            <a href="{{ block.settings.link }}" class="qs-instagram__anchor" {% if block.settings.link contains 'http' %}target="_blank" rel="noopener"{% endif %}>
          {% endif %}
          {% if block.settings.image != blank %}
            {{
              block.settings.image
              | image_url: width: 800
              | image_tag:
                loading: 'lazy',
                sizes: '(min-width: 990px) 25vw, 50vw',
                widths: '300, 500, 800',
                alt: section.settings.title
            }}
          {% else %}
            {{ 'image' | placeholder_svg_tag: 'qs-instagram__placeholder' }}
          {% endif %}
          {% if block.settings.link != blank %}
            </a>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Instagram gallery",
  "tag": "section",
  "class": "section-qs-instagram",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "In real life"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Soft light, quiet details—tag us to be featured."
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "text",
      "id": "instagram_label",
      "label": "Link label",
      "default": "@yourbrand"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram gallery",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
